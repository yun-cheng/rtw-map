{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A run of the destinations prompt: the places worth staying in, in each country",
  "type": "object",
  "required": ["countries"],
  "properties": {
    "countries": {
      "type": "object",
      "description": "By the country's code in the list asked about.",
      "propertyNames": { "pattern": "^[A-Z]{2}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["country", "places"],
        "properties": {
          "country": { "type": "string" },
          "places": {
            "type": "array",
            "minItems": 1,
            "maxItems": 25,
            "items": {
              "type": "object",
              "required": ["name", "rank", "world", "kind", "days", "tags", "wikipedia", "why", "sure"],
              "properties": {
                "name": { "type": "string" },
                "local": { "type": "string" },
                "rank": { "type": "integer", "minimum": 1 },
                "world": { "type": "integer", "minimum": 1, "maximum": 5, "description": "How it compares with places to stay worldwide (not within its country)." },
                "kind": { "enum": ["city", "town", "island", "beach", "mountains", "nature"] },
                "days": {
                  "type": "object",
                  "required": ["min", "ideal", "max"],
                  "description": "Whole days or halves; min ≤ ideal ≤ max.",
                  "properties": { "min": { "type": "number", "exclusiveMinimum": 0 }, "ideal": { "type": "number", "exclusiveMinimum": 0 }, "max": { "type": "number", "exclusiveMinimum": 0 } }
                },
                "tags": { "type": "array", "minItems": 1, "items": { "enum": ["city", "culture", "history", "food", "nightlife", "nature", "hiking", "beach"] } },
                "wikipedia": { "type": ["string", "null"], "description": "The English Wikipedia article's title." },
                "base": {
                  "type": "object",
                  "description": "For an area (a park, a bay, an island group…): the town or village visitors stay in. Required for kind nature; none for a city or town.",
                  "required": ["name", "wikipedia"],
                  "properties": { "name": { "type": "string" }, "local": { "type": "string" }, "wikipedia": { "type": ["string", "null"] } }
                },
                "why": { "type": "string" },
                "sure": { "enum": ["high", "medium", "low"] },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
