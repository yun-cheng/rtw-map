{
  "name": "rtw-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787 --env-file .env.local",
    "dev:runner": "tsx watch --env-file=.env.local runner/index.ts",
    "build:runner": "esbuild runner/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=build/runner/index.mjs --log-level=warning && cp runner/Dockerfile build/runner/",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "data:build": "tsx scripts/build-cities.ts && tsx scripts/build-boundaries.ts && tsx scripts/build-seed.ts && tsx scripts/build-roads.ts && tsx scripts/build-visa.ts && tsx scripts/build-climate.ts && tsx scripts/build-air.ts && tsx scripts/build-mobile.ts && tsx scripts/build-places.ts && tsx scripts/fetch-amenities.ts",
    "data:refresh": "tsx scripts/build-seed.ts && tsx scripts/fetch-population.ts && tsx scripts/fetch-advisories.ts && tsx scripts/fetch-health.ts && tsx scripts/fetch-fx.ts && tsx scripts/fetch-price-levels.ts && tsx scripts/fetch-big-mac.ts",
    "data:pull": "tsx scripts/r2.ts pull",
    "data:push": "tsx scripts/r2.ts push",
    "data:snapshots": "tsx scripts/r2.ts snapshots",
    "data:restore": "tsx scripts/r2.ts restore"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "aws4fetch": "^1.0.20",
    "esbuild": "^0.28.2",
    "hyparquet": "^1.31.2",
    "hyparquet-compressors": "^1.1.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
